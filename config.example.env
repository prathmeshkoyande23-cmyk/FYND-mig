# Copy to .env, fill in, then run:  set -a; source .env; set +a
# Never commit the real .env file, your client secret or a token to GitHub.

FYND_COMPANY_ID=17411
FYND_BRAND_UID=
# Fynd takes exactly ONE department per product: the id of the department "Others" belongs to
FYND_DEPARTMENTS=
# Id of a tax rule that already exists on your company (Fynd needs this for every product)
FYND_TAX_RULE_ID=
FYND_CATEGORY_SLUG=others
FYND_TEMPLATE_TAG=supplementary

# Sign-in. Easiest: fill in the client ID and secret and the script gets its own token
# and fetches a new one if it expires mid-run (tokens last about an hour).
# Create them in the Fynd Commerce panel: Company > Developers > Clients > Create Client.
FYND_CLIENT_ID=6ad1d7fb01107bf82d0abed1
FYND_CLIENT_SECRET=cPkULdBSswi1smF

# Or paste a token you generated yourself (leave the two lines above empty).
FYND_ACCESS_TOKEN=

# Optional
# FYND_HOST=https://api.fynd.com
# FYND_CREATE_PATH=/service/platform/catalog/v3.0/company/{company_id}/products/
# FYND_COUNTRY_OF_ORIGIN=India
# FYND_RETURNABLE=true
# FYND_RETURN_DAYS=7
# FYND_TRADER_NAME=Meridian Apparel
# FYND_TRADER_TYPE=Manufacturer
# FYND_TRADER_ADDRESS=India
# Extra template attributes as JSON, only if the Supplementary template asks for any
# FYND_ATTRIBUTES_JSON={}
# FYND_TOKEN_SCOPE=company/*,company/application/*
